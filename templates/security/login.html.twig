{% extends 'base.html.twig' %}

{% block title %}Connexion — MJ Vaubécourt{% endblock %}

{% block body %}
<div class="relative min-h-[calc(100vh-12rem)] flex items-center justify-center bg-base-200 py-12 lg:py-20 px-4 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 -right-32 w-[28rem] h-[28rem] rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute bottom-0 -left-24 w-[24rem] h-[24rem] rounded-full bg-secondary/10 blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-md">
    <div class="relative bg-base-100 rounded-3xl shadow-2xl border border-base-300 overflow-hidden">
      {# Top accent strip #}
      <div class="h-1.5 flex" aria-hidden="true">
        <span class="flex-1 bg-primary"></span>
        <span class="w-12 bg-secondary"></span>
        <span class="w-6 bg-accent"></span>
      </div>

      <div class="p-8 lg:p-10 text-center space-y-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-primary text-primary-content font-black text-lg shadow-lg mx-auto">
          MJV
        </div>

        <div class="space-y-2">
          <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
            <span class="w-6 h-0.5 bg-primary"></span> Connexion <span class="w-6 h-0.5 bg-primary"></span>
          </p>
          <h1 class="text-3xl font-black tracking-tight">Bienvenue !</h1>
          <p class="text-base-content/60 text-sm leading-relaxed">
            Connectez-vous pour participer au forum et commenter les actualités.
          </p>
        </div>

        {% if error is defined and error %}
          <div class="alert alert-error rounded-2xl text-sm text-left" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="font-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
          </div>
        {% endif %}

        <a href="{{ path('connect_google_start') }}"
           class="inline-flex items-center justify-center gap-3 w-full px-6 py-4 rounded-full bg-base-100 border-2 border-base-300 text-base-content font-black text-base hover:border-primary hover:bg-base-200/50 hover:shadow-lg transition min-h-[52px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5 flex-shrink-0">
            <path fill="#EA4335" d="M24 9.5c3.14 0 5.95 1.08 8.17 2.86l6.09-6.09C34.46 3.1 29.5 1 24 1 14.82 1 7.01 6.7 3.69 14.7l7.08 5.5C12.43 13.7 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.1 24.5c0-1.64-.15-3.22-.42-4.74H24v8.98h12.42c-.54 2.9-2.18 5.36-4.64 7.01l7.19 5.58C43.18 37.06 46.1 31.25 46.1 24.5z"/>
            <path fill="#FBBC05" d="M10.77 28.2A14.55 14.55 0 0 1 9.5 24c0-1.46.25-2.88.7-4.2l-7.08-5.5A23.94 23.94 0 0 0 0 24c0 3.86.92 7.5 2.55 10.72l8.22-6.52z"/>
            <path fill="#34A853" d="M24 47c5.5 0 10.12-1.82 13.49-4.94l-7.19-5.58c-1.99 1.34-4.54 2.13-6.3 2.13-6.26 0-11.57-4.2-13.23-9.87l-8.22 6.52C7.01 41.3 14.82 47 24 47z"/>
            <path fill="none" d="M0 0h48v48H0z"/>
          </svg>
          Se connecter avec Google
        </a>

        <p class="text-xs text-base-content/60 leading-relaxed pt-2 border-t border-base-200">
          En vous connectant, vous acceptez les <a href="{{ path('app_mentions_legales') }}" class="text-primary font-bold hover:underline">conditions d'utilisation</a> du site.
        </p>
      </div>
    </div>

    <p class="text-center text-xs text-base-content/50 mt-5 font-semibold">
      <a href="{{ path('app_main') }}" class="hover:text-primary transition">← Retour à l'accueil</a>
    </p>
  </div>
</div>
{% endblock %}
