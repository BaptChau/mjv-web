{% extends 'base.html.twig' %}

{% block title %}Connexion - MJ Vaubécourt{% endblock %}

{% block body %}
<main class="flex items-center justify-center min-h-[70vh] px-4">
  <div class="bg-base-100 border border-base-200 rounded-2xl shadow-lg p-6 lg:p-10 w-full max-w-sm text-center">

    <h1 class="text-2xl font-bold mb-2">Connexion</h1>
    <p class="text-base-content/60 text-sm mb-8">
      Connectez-vous pour participer au forum et commenter les actualités.
    </p>

    {% if error is defined and error %}
      <div class="alert alert-error mb-6 text-sm" role="alert">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    <a href="{{ path('connect_google_start') }}"
       class="btn btn-outline btn-block gap-3 normal-case text-base font-medium min-h-[44px]">
      {# Google "G" SVG logo #}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5 flex-shrink-0">
        <path fill="#EA4335" d="M24 9.5c3.14 0 5.95 1.08 8.17 2.86l6.09-6.09C34.46 3.1 29.5 1 24 1 14.82 1 7.01 6.7 3.69 14.7l7.08 5.5C12.43 13.7 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.1 24.5c0-1.64-.15-3.22-.42-4.74H24v8.98h12.42c-.54 2.9-2.18 5.36-4.64 7.01l7.19 5.58C43.18 37.06 46.1 31.25 46.1 24.5z"/>
        <path fill="#FBBC05" d="M10.77 28.2A14.55 14.55 0 0 1 9.5 24c0-1.46.25-2.88.7-4.2l-7.08-5.5A23.94 23.94 0 0 0 0 24c0 3.86.92 7.5 2.55 10.72l8.22-6.52z"/>
        <path fill="#34A853" d="M24 47c5.5 0 10.12-1.82 13.49-4.94l-7.19-5.58c-1.99 1.34-4.54 2.13-6.3 2.13-6.26 0-11.57-4.2-13.23-9.87l-8.22 6.52C7.01 41.3 14.82 47 24 47z"/>
        <path fill="none" d="M0 0h48v48H0z"/>
      </svg>
      Se connecter avec Google
    </a>

    <p class="mt-8 text-xs text-base-content/60">
      En vous connectant, vous acceptez les conditions d'utilisation du site.
    </p>
  </div>
</main>
{% endblock %}
