<!DOCTYPE html>
<html data-theme="light" lang="fr" id="html-root">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('favicon-96x96.png') }}">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <script>
      (function () {
        var t = localStorage.getItem('theme') || 'light';
        document.getElementById('html-root').setAttribute('data-theme', t);
      })();
      var themes = ['light', 'dark', 'halloween'];
      function applyThemeIcons(theme) {
        var icons = { sun: 'light', moon: 'dark', star: 'halloween' };
        for (var id in icons) {
          var el = document.getElementById('icon-' + id);
          if (el) el.classList.toggle('hidden', icons[id] !== theme);
        }
      }
      function toggleTheme() {
        var current = document.getElementById('html-root').getAttribute('data-theme');
        var idx = themes.indexOf(current);
        var next = themes[(idx + 1) % themes.length];
        document.getElementById('html-root').setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        applyThemeIcons(next);
      }
      document.addEventListener('DOMContentLoaded', function () {
        applyThemeIcons(localStorage.getItem('theme') || 'light');
      });
    </script>

        {# ==================== SEO ==================== #}
        {# Reusable variables — child templates override the blocks below #}
        {% set site_name = 'MJ Vaubécourt' %}
        {% set site_url = 'https://mj-vaubecourt.fr' %}
        {% set default_description = 'MJ Vaubécourt — club de handball à Vaubécourt (Meuse, 55). Le handball c\'est notre passion magique : équipes jeunes et seniors, calendrier des matchs, actualités et école de hand.' %}
        {% set default_image = site_url ~ '/build/images/og-default.jpg' %}
        {% set canonical_url = block('canonical') is defined and block('canonical')|trim is not empty ? block('canonical') : (app.request is defined and app.request ? site_url ~ app.request.pathInfo : site_url) %}

        <title>{% block title %}MJ Vaubécourt — Club de handball à Vaubécourt (Meuse){% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ default_description }}{% endblock %}">
        <meta name="keywords" content="{% block meta_keywords %}handball Vaubécourt, MJ Vaubécourt, club handball Meuse, handball 55, école de hand Meuse, MJV handball{% endblock %}">
        <meta name="author" content="MJ Vaubécourt">
        <meta name="robots" content="{% block meta_robots %}index, follow, max-image-preview:large{% endblock %}">
        <meta name="theme-color" content="#1d232a">
        <meta name="geo.region" content="FR-55">
        <meta name="geo.placename" content="Vaubécourt">

        <link rel="canonical" href="{% block canonical %}{{ site_url }}{{ app.request.pathInfo }}{% endblock %}">
        <link rel="alternate" hreflang="fr" href="{{ site_url }}{{ app.request.pathInfo }}">

        {# Open Graph #}
        <meta property="og:site_name" content="{{ site_name }}">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{% block og_url %}{{ site_url }}{{ app.request.pathInfo }}{% endblock %}">
        <meta property="og:image" content="{% block og_image %}{{ default_image }}{% endblock %}">
        <meta property="og:image:alt" content="{% block og_image_alt %}Logo et identité visuelle du MJ Vaubécourt handball{% endblock %}">

        {# Twitter Card #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">

        {# JSON-LD structured data — Organization / SportsClub on every page #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "SportsClub",
          "name": "MJ Vaubécourt",
          "alternateName": "Maison des jeunes Vaubécourt handball",
          "sport": "Handball",
          "slogan": "Le handball c'est notre passion magique",
          "url": "{{ site_url }}",
          "logo": "{{ default_image }}",
          "image": "{{ default_image }}",
          "description": "{{ default_description }}",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "5 route de Clermont",
            "postalCode": "55250",
            "addressLocality": "Fleury-sur-Aire",
            "addressRegion": "Meuse",
            "addressCountry": "FR"
          },
          "areaServed": {
            "@type": "Place",
            "name": "Vaubécourt, Meuse, France"
          }
        }
        </script>

        {% block structured_data %}{% endblock %}
        {% block seo_extra %}{% endblock %}
        {# ================== END SEO ================== #}

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
<script src="//unpkg.com/alpinejs" defer></script>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="flex flex-col min-h-screen overflow-x-hidden bg-base-100 text-base-content antialiased text-base leading-relaxed selection:bg-primary selection:text-primary-content">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-content focus:rounded-full focus:text-sm focus:font-bold focus:shadow-xl">Aller au contenu principal</a>
        {% include 'components/navbar.html.twig' %}
        <main id="main-content" class="flex-1 pb-20 lg:pb-0" tabindex="-1">
        {% block body %}{% endblock %}
        </main>
        {% include 'components/footer.html.twig' %}
    </body>
</html>
