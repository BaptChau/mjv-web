{% extends "base.html.twig" %}

{% block title %}Calendrier — MJ Vaubécourt{% endblock %}

{% block body %}
<div>
  {# ==================== HERO ==================== #}
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-24 w-[28rem] h-[28rem] rounded-full bg-primary/20 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-[20rem] h-[20rem] rounded-full bg-accent/15 blur-3xl"></div>
    </div>
    <div class="relative max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-24 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8 space-y-5">
        <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
          <span class="w-8 h-0.5 bg-primary"></span> Calendrier
        </p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[0.95] tracking-tight">
          Tous les <span class="text-primary">matchs</span><br>
          en un coup d'œil.
        </h1>
        <p class="text-base sm:text-lg text-neutral-content/75 max-w-xl leading-relaxed">
          Prochaines rencontres, résultats récents, recherche par date — tout pour suivre vos équipes préférées.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#upcoming" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-xl hover:scale-105 transition min-h-[48px]">Prochains matchs</a>
          <a href="#search" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full border-2 border-neutral-content/30 font-black uppercase tracking-wide text-sm hover:bg-neutral-content/10 transition min-h-[48px]">Rechercher</a>
        </div>
      </div>
      <div class="lg:col-span-4 grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">À venir</dt>
          <dd class="text-4xl lg:text-5xl font-black mt-2 tabular-nums text-primary">{{ upcomingMatches|length }}</dd>
        </div>
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">Résultats</dt>
          <dd class="text-4xl lg:text-5xl font-black mt-2 tabular-nums">{{ lastWeekResults|length }}</dd>
        </div>
      </div>
    </div>
  </section>

  {# ==================== UPCOMING ==================== #}
  <section id="upcoming" class="py-14 lg:py-24 bg-base-100 scroll-mt-24">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <header class="space-y-2">
        <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
          <span class="w-8 h-0.5 bg-primary"></span> À venir
        </p>
        <h2 class="text-3xl lg:text-4xl font-black tracking-tight">Prochains matchs</h2>
        <p class="text-base-content/70">Rendez-vous sur les terrains pour encourager nos équipes.</p>
      </header>

      <ul class="grid gap-4 sm:gap-5 sm:grid-cols-2 xl:grid-cols-3" role="list">
        {% for match in upcomingMatches %}
          {% set isHome = match.homeTeam == match.team.label %}
          {% set opponent = isHome ? match.awayTeam : match.homeTeam %}
          <li>
            <article class="group relative rounded-2xl border border-base-300 bg-base-100 hover:border-primary hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1 bg-primary scale-x-0 group-hover:scale-x-100 origin-left transition-transform" aria-hidden="true"></div>
              <div class="p-5 lg:p-6 space-y-4">
                <div class="flex items-start justify-between gap-3">
                  <time datetime="{{ match.matchDate|date('Y-m-d') }}"
                        class="flex flex-col items-center justify-center w-16 h-16 rounded-2xl bg-primary text-primary-content shadow-md shrink-0">
                    <span class="text-2xl font-black leading-none tabular-nums">{{ match.matchDate|date('d') }}</span>
                    <span class="text-[10px] uppercase tracking-widest font-black mt-0.5">{{ match.matchDate|date('M') }}</span>
                  </time>
                  {% if isHome %}
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-primary/15 text-primary text-[10px] font-black uppercase tracking-widest">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Domicile
                    </span>
                  {% else %}
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-base-200 text-base-content/70 text-[10px] font-black uppercase tracking-widest">
                      Extérieur
                    </span>
                  {% endif %}
                </div>
                <div>
                  <p class="text-[10px] font-black uppercase tracking-[0.2em] text-base-content/60 truncate">{{ match.team.label }}</p>
                  <p class="text-lg font-black leading-tight mt-1 truncate">vs {{ opponent }}</p>
                </div>
                <div class="flex items-center justify-between pt-3 border-t border-base-200 text-xs font-bold">
                  <span class="inline-flex items-center gap-1.5 text-base-content/70">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>
                    <span class="tabular-nums">{{ match.matchDate|date('H\\hi') }}</span>
                  </span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full border border-base-300 text-[10px] uppercase tracking-wider">J{{ match.matchDay }}</span>
                </div>
              </div>
            </article>
          </li>
        {% else %}
          <li class="sm:col-span-2 xl:col-span-3">
            <div class="text-center py-16 px-4 rounded-3xl border-2 border-dashed border-base-300">
              <svg class="w-12 h-12 mx-auto text-base-content/30 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M8 3v4M16 3v4M3 11h18"/></svg>
              <p class="text-base-content/60 font-semibold">Aucun match annoncé pour le moment.</p>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# ==================== RESULTS ==================== #}
  <section class="py-14 lg:py-24 bg-base-200">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <header class="space-y-2">
        <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-secondary">
          <span class="w-8 h-0.5 bg-secondary"></span> Récemment
        </p>
        <h2 class="text-3xl lg:text-4xl font-black tracking-tight">Résultats de la semaine</h2>
        <p class="text-base-content/70">Les scores des derniers matchs joués par le club.</p>
      </header>

      <ul class="grid gap-3 lg:grid-cols-2" role="list">
        {% for match in lastWeekResults %}
          {% set isHome = match.homeTeam == match.team.label %}
          {% set opponent = isHome ? match.awayTeam : match.homeTeam %}
          {% set ourScore = isHome ? match.homeScore : match.awayScore %}
          {% set theirScore = isHome ? match.awayScore : match.homeScore %}
          {% set outcome = ourScore > theirScore ? 'win' : (ourScore < theirScore ? 'loss' : 'draw') %}
          {% set outcomeChip = outcome == 'win' ? 'bg-success text-success-content' : (outcome == 'loss' ? 'bg-error text-error-content' : 'bg-warning text-warning-content') %}
          {% set outcomeLabel = outcome == 'win' ? 'Victoire' : (outcome == 'loss' ? 'Défaite' : 'Nul') %}
          {% set outcomeLetter = outcome == 'win' ? 'V' : (outcome == 'loss' ? 'D' : 'N') %}
          <li>
            <article class="rounded-2xl border border-base-300 bg-base-100 p-5 flex items-center gap-4 hover:shadow-lg transition-shadow">
              <time datetime="{{ match.matchDate|date('Y-m-d') }}"
                    class="flex flex-col items-center justify-center w-14 h-14 rounded-xl bg-base-200 shrink-0">
                <span class="text-xl font-black leading-none tabular-nums">{{ match.matchDate|date('d') }}</span>
                <span class="text-[9px] uppercase tracking-widest font-black text-base-content/60 mt-0.5">{{ match.matchDate|date('M') }}</span>
              </time>
              <div class="flex-1 min-w-0">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-base-content/60 truncate">{{ match.team.label }}</p>
                <p class="text-base font-black leading-tight truncate mt-0.5">vs {{ opponent }}</p>
                <p class="text-[10px] font-bold text-base-content/50 mt-0.5 uppercase tracking-wider">{{ isHome ? 'Domicile' : 'Extérieur' }} · J{{ match.matchDay }}</p>
              </div>
              <div class="flex flex-col items-end gap-1.5 shrink-0">
                <span class="text-2xl font-black tabular-nums leading-none">{{ match.homeScore }}<span class="text-base-content/40">–</span>{{ match.awayScore }}</span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full {{ outcomeChip }} text-[10px] font-black uppercase tracking-widest shadow-sm">
                  <span class="font-black">{{ outcomeLetter }}</span> <span class="hidden sm:inline">{{ outcomeLabel }}</span>
                </span>
              </div>
            </article>
          </li>
        {% else %}
          <li class="lg:col-span-2 text-center py-16 px-4 rounded-3xl border-2 border-dashed border-base-300 bg-base-100">
            <p class="text-base-content/60 font-semibold">Aucun résultat cette semaine.</p>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# ==================== SEARCH ==================== #}
  <section id="search" class="py-14 lg:py-24 bg-base-100 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-base-300 bg-base-100 overflow-hidden shadow-lg">
        <header class="p-6 lg:p-8 bg-base-200/50 border-b border-base-300 space-y-2">
          <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
            <span class="w-8 h-0.5 bg-primary"></span> Rechercher
          </p>
          <h2 class="text-2xl lg:text-3xl font-black tracking-tight">Résultats par date</h2>
          <p class="text-base-content/70 text-sm">Choisissez une date pour afficher les scores correspondants.</p>
        </header>

        <div class="p-6 lg:p-8 space-y-5">
          <form class="flex flex-col gap-3 sm:flex-row sm:items-end" method="get">
            <div class="flex-1">
              <label for="date-input" class="block text-[11px] font-black uppercase tracking-wider text-base-content/70 mb-1.5">Date du match</label>
              <input
                id="date-input"
                class="input input-bordered w-full rounded-xl font-semibold focus:border-primary focus:ring-2 focus:ring-primary"
                type="date"
                name="date"
                value="{{ selectedDate ? selectedDate|date('Y-m-d') : '' }}"
              />
            </div>
            <div class="flex gap-2">
              <button class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition min-h-[44px]" type="submit">Afficher</button>
              {% if selectedDate %}
                <a href="{{ path('app_calendar') }}" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">Reset</a>
              {% endif %}
            </div>
          </form>

          <div class="grid gap-3" aria-live="polite">
            {% if selectedDateResults is not empty %}
              {% for match in selectedDateResults %}
                {% set isHome = match.homeTeam == match.team.label %}
                {% set opponent = isHome ? match.awayTeam : match.homeTeam %}
                <div class="rounded-2xl border border-base-300 p-4 flex items-center justify-between gap-4">
                  <div class="min-w-0">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-base-content/60 truncate">{{ match.team.label }}</p>
                    <p class="text-base font-black truncate mt-0.5">vs {{ opponent }}</p>
                    <p class="text-[10px] font-bold text-base-content/50 mt-0.5 uppercase tracking-wider">{{ isHome ? 'Domicile' : 'Extérieur' }} · J{{ match.matchDay }}</p>
                  </div>
                  <div class="text-2xl font-black tabular-nums shrink-0">{{ match.homeScore }}<span class="text-base-content/40">–</span>{{ match.awayScore }}</div>
                </div>
              {% endfor %}
            {% elseif selectedDate %}
              <div class="rounded-2xl border-2 border-dashed border-base-300 p-8 text-center">
                <p class="text-base-content/60 font-semibold">Aucun résultat pour la date sélectionnée.</p>
              </div>
            {% else %}
              <div class="rounded-2xl bg-base-200/50 p-6 text-center">
                <p class="text-sm text-base-content/60">Sélectionnez une date pour afficher un résultat.</p>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{% endblock %}
