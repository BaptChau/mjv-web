{% extends "base.html.twig" %}

{% set post_excerpt = post.body|striptags|slice(0, 155)|trim %}

{% block title %}{{ post.title }} — Forum MJ Vaubécourt{% endblock %}
{% block meta_description %}{{ post_excerpt }}{% if post_excerpt|length >= 155 %}…{% endif %}{% endblock %}
{% block og_type %}article{% endblock %}
{# Forum threads are user-generated; allow indexing but don't waste budget on auth-gated reply pages #}
{% block meta_robots %}index, follow{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DiscussionForumPosting",
  "headline": {{ post.title|json_encode|raw }},
  "text": {{ post_excerpt|json_encode|raw }},
  "url": "{{ site_url }}{{ app.request.pathInfo }}",
  "datePublished": "{{ post.createdAt is defined ? post.createdAt|date('c') : '' }}",
  "author": { "@type": "Person", "name": {{ post.author|json_encode|raw }} },
  "interactionStatistic": {
    "@type": "InteractionCounter",
    "interactionType": "https://schema.org/CommentAction",
    "userInteractionCount": {{ answers_count|default(0) }}
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ site_url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Forum", "item": "{{ site_url }}{{ path('app_forum') }}" },
    { "@type": "ListItem", "position": 3, "name": {{ post.title|json_encode|raw }}, "item": "{{ site_url }}{{ app.request.pathInfo }}" }
  ]
}
</script>
{% endblock %}

{% block body %}
<div>
  {# ==================== HERO ==================== #}
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-24 w-[24rem] h-[24rem] rounded-full bg-accent/15 blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16 space-y-5">
      <nav class="text-xs" aria-label="Fil d'Ariane">
        <ol class="flex items-center gap-2 text-neutral-content/70 font-semibold">
          <li><a href="{{ path('app_forum') }}" class="hover:text-neutral-content hover:underline">Forum</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-neutral-content/90 truncate max-w-[60vw]" aria-current="page">{{ post.title }}</li>
        </ol>
      </nav>
      <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-accent">
        <span class="w-8 h-0.5 bg-accent"></span> Discussion
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-[1.05] tracking-tight">{{ post.title }}</h1>
      <ul class="flex flex-wrap gap-2" role="list">
        <li class="inline-flex items-center gap-2 rounded-full bg-neutral-content/10 border border-neutral-content/20 px-3 py-1.5 text-xs font-bold">
          <span class="w-6 h-6 rounded-full bg-primary text-primary-content text-[10px] font-black flex items-center justify-center">{{ post.author|first|upper }}</span>
          {{ post.author }}
        </li>
        {% if post.createdAt is defined %}
          <li class="inline-flex items-center gap-2 rounded-full bg-neutral-content/10 border border-neutral-content/20 px-3 py-1.5 text-xs font-bold tabular-nums">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
            {{ post.createdAt|date('d/m/Y · H:i') }}
          </li>
        {% endif %}
        <li class="inline-flex items-center gap-2 rounded-full bg-accent text-accent-content px-3 py-1.5 text-xs font-black uppercase tracking-wider">
          {{ answers_count|default(0) }} réponse{{ answers_count|default(0) <= 1 ? '' : 's' }}
        </li>
      </ul>
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        {% if is_granted('ROLE_USER') %}
          <button
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition min-h-[44px]"
            onclick="document.getElementById('answer-modal-main').showModal();return false;"
            type="button"
          >Répondre</button>
        {% else %}
          <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition min-h-[44px]">Se connecter pour répondre</a>
        {% endif %}
        <a href="{{ path('app_forum') }}" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border-2 border-neutral-content/30 font-black uppercase tracking-wide text-sm hover:bg-neutral-content/10 transition min-h-[44px]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Retour
        </a>
      </div>
    </div>
  </section>

  {# ==================== BODY ==================== #}
  <section class="py-10 lg:py-16 bg-base-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      {# Original post #}
      <article class="rounded-3xl border-l-4 border-l-primary border border-base-300 bg-base-100 p-6 lg:p-8 space-y-4">
        <header class="flex items-center gap-3">
          <span class="w-12 h-12 rounded-full bg-primary text-primary-content font-black flex items-center justify-center shadow-md">
            {{ post.author|first|upper }}
          </span>
          <div>
            <p class="text-sm font-black">{{ post.author }}</p>
            {% if post.createdAt is defined %}
              <time datetime="{{ post.createdAt|date('c') }}" class="text-xs font-semibold text-base-content/60 tabular-nums">{{ post.createdAt|date('d/m/Y · H:i') }}</time>
            {% endif %}
          </div>
          <span class="ml-auto px-3 py-1 rounded-full bg-primary/15 text-primary text-[10px] font-black uppercase tracking-wider">Sujet</span>
        </header>
        <p class="text-base lg:text-lg text-base-content/85 leading-relaxed whitespace-pre-line">{{ post.body|nl2br }}</p>
      </article>

      {# Answers section #}
      <section aria-labelledby="answers-heading" class="rounded-3xl border border-base-300 bg-base-100 overflow-hidden">
        <header class="p-6 lg:p-8 border-b border-base-200 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div class="space-y-1">
            <p class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.25em] text-secondary">
              <span class="w-2 h-2 rounded-sm bg-secondary"></span> Réponses
            </p>
            <h2 id="answers-heading" class="text-2xl lg:text-3xl font-black tracking-tight">{{ answers_count|default(0) }} contribution{{ answers_count|default(0) <= 1 ? '' : 's' }}</h2>
          </div>
          {% if is_granted('ROLE_USER') %}
            <button
              class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-secondary text-secondary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition self-start min-h-[44px]"
              onclick="document.getElementById('answer-modal-main').showModal();return false;"
              type="button"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
              Ajouter
            </button>
          {% endif %}
        </header>

        <div class="p-6 lg:p-8">
          {% if answers is not empty %}
            <ul class="space-y-3" role="list">
              {% for answer in answers %}
                {% include 'components/answer.html.twig' with {answer: answer, level: 0} %}
              {% endfor %}
            </ul>
          {% else %}
            <div class="rounded-2xl border-2 border-dashed border-base-300 p-8 text-center">
              <p class="text-base-content/60 font-semibold">Soyez la première personne à répondre.</p>
            </div>
          {% endif %}
        </div>
      </section>

      <aside class="rounded-3xl bg-base-200 p-6 lg:p-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <p class="text-[11px] font-black uppercase tracking-[0.25em] text-primary">Envie d'en parler de vive voix ?</p>
          <h3 class="text-xl font-black tracking-tight">L'équipe MJ Vaubécourt reste disponible</h3>
          <p class="text-base-content/70 text-sm">Contactez un dirigeant, un coach ou un bénévole pour un coup de main immédiat.</p>
        </div>
        <a href="{{ path('app_contact') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition md:shrink-0 min-h-[44px]">Contact</a>
      </aside>
    </div>
  </section>
</div>

{% if is_granted('ROLE_USER') %}
<dialog id="answer-modal-main" class="modal" aria-label="Répondre au sujet">
  <div class="modal-box max-w-xl rounded-3xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" onclick="document.getElementById('answer-modal-main').close()" type="button" aria-label="Fermer la fenêtre">✕</button>
    </form>
    {% include 'forum/form.html.twig' with {form: answer_form, title: 'Répondre'} %}
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
{% endif %}
{% endblock %}
