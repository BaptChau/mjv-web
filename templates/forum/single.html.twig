{% extends "base.html.twig" %}
{% block title %}{{ post.title }}{% endblock %}
{% block body %}
<section class="bg-base-100 py-8 antialiased dark:bg-gray-900 md:py-16">
  <div class="mx-auto max-w-2xl px-4 2xl:px-0">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-4 mb-8">
      <h1 class="shrink-0 text-2xl font-bold text-base-content">{{ post.title }}</h1>
      <button 
        class="btn btn-primary w-full md:w-auto"
        onclick="document.getElementById('answer-modal-main').showModal();return false;"
        type="button"
      >Répondre</button>

      <dialog id="answer-modal-main" class="modal">
        <div class="modal-box max-w-xl">
          <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" onclick="document.getElementById('answer-modal-main').close()" type="button">✕</button>
          </form>
          {% include 'forum/form.html.twig' with {form: answer_form, title: 'Répondre'} %}
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    </div>
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-semibold text-base-content">{{ post.author }}</span>
      </div>
      <p class="mb-4 text-base-content">{{ post.body }}</p>
    </div>

    {% if answers is not empty %}
      <div class="flow-root">
        <div class="-my-6 divide-y divide-base-200 dark:divide-gray-800">
          <h2 class="text-xl font-semibold mb-6 text-base-content">Réponses</h2>
          <ul>
            {% for answer in answers %}
              {% include 'components/answer.html.twig' with {answer: answer, level: 0} %}
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}