{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <article>
        <h1 class="text-4xl font-bold">{{ post.title }}</h1>
        <p class="text-gray-500">Posté le {{ post.createdAt|date('d/m/Y') }} par {{ post.author.username }}</p>
        <div class="mt-6">
            {{ post.content|raw }}
        </div>
    </article>
{% endblock %}
