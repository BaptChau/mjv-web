{% extends "base.html.twig" %}
{% block title %}{{ post.title }}{% endblock %}
{% block body %}
<main class="bg-base-200 min-h-screen">
  <section class="bg-neutral text-neutral-content">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-16 space-y-4 lg:space-y-6">
      <p class="text-xs uppercase tracking-[0.5em] text-neutral-content/70">Forum · Question</p>
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">{{ post.title }}</h1>
      <div class="flex flex-wrap gap-3 text-sm uppercase tracking-[0.3em] text-neutral-content/70">
        <span class="rounded-full border border-neutral-content/30 px-4 py-1">{{ post.author }}</span>
        {% if post.createdAt is defined %}
          <span class="rounded-full border border-neutral-content/30 px-4 py-1">{{ post.createdAt|date('d/m/Y H:i') }}</span>
        {% endif %}
        <span class="rounded-full border border-neutral-content/30 px-4 py-1">{{ answers_count|default(0) }} réponse{{ answers_count|default(0) <= 1 ? '' : 's' }}</span>
      </div>
      <div class="flex flex-wrap gap-3">
        {% if is_granted('ROLE_USER') %}
          <button
            class="btn btn-primary w-full sm:btn-wide"
            onclick="document.getElementById('answer-modal-main').showModal();return false;"
            type="button"
          >Répondre</button>
        {% else %}
          <a href="{{ path('app_login') }}" class="btn btn-primary w-full sm:btn-wide">
            Connectez-vous pour répondre
          </a>
        {% endif %}
        <a href="{{ path('app_forum') }}" class="btn btn-outline btn-primary btn-sm lg:btn-md flex-1 lg:flex-none">Retour au forum</a>
      </div>
    </div>
  </section>

  <section class="py-8 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 space-y-8 lg:space-y-12">
      <article class="card bg-base-100 rounded-3xl shadow-xl border border-base-300">
        <div class="card-body space-y-4">
          <div class="flex items-center gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Auteur</p>
              <p class="text-lg font-semibold text-base-content">{{ post.author }}</p>
            </div>
          </div>
          <p class="text-base text-base-content/80 leading-relaxed">{{ post.body|nl2br }}</p>
        </div>
      </article>

      <article class="card bg-base-100 rounded-3xl shadow-xl border border-base-300">
        <div class="card-body space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Réponses</p>
              <h2 class="text-2xl font-bold text-base-content">{{ answers_count|default(0) }} contribution{{ answers_count|default(0) <= 1 ? '' : 's' }}</h2>
            </div>
            {% if is_granted('ROLE_USER') %}
              <button
                class="btn btn-sm btn-primary"
                onclick="document.getElementById('answer-modal-main').showModal();return false;"
                type="button"
              >Ajouter une réponse</button>
            {% else %}
              <a href="{{ path('app_login') }}" class="btn btn-sm btn-primary">
                Connexion pour répondre
              </a>
            {% endif %}
          </div>

          {% if answers is not empty %}
            <ul class="space-y-4">
              {% for answer in answers %}
                {% include 'components/answer.html.twig' with {answer: answer, level: 0} %}
              {% endfor %}
            </ul>
          {% else %}
            <p class="text-base-content/70">Soyez la première personne à répondre à ce sujet.</p>
          {% endif %}
        </div>
      </article>

      <article class="card bg-base-100 rounded-3xl shadow-lg border border-base-300">
        <div class="card-body items-start gap-4 md:flex md:items-center md:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Envie d'en parler de vive voix ?</p>
            <h3 class="text-2xl font-bold text-base-content">L'équipe MJ Vaubécourt reste disponible.</h3>
            <p class="text-base-content/70">Contactez un dirigeant, un coach ou un bénévole pour obtenir un coup de main immédiat.</p>
          </div>
          <a href="{{ path('app_contact') }}" class="btn btn-outline btn-primary">Contacter le club</a>
        </div>
      </article>
    </div>
  </section>
</main>

{% if is_granted('ROLE_USER') %}
<dialog id="answer-modal-main" class="modal" aria-label="Répondre au sujet">
  <div class="modal-box max-w-xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" onclick="document.getElementById('answer-modal-main').close()" type="button" aria-label="Fermer la fenêtre">✕</button>
    </form>
    {% include 'forum/form.html.twig' with {form: answer_form, title: 'Répondre'} %}
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
{% endif %}
{% endblock %}
