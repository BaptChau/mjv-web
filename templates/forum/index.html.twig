{% extends "base.html.twig" %}

{% block title %}Forum — MJ Vaubécourt{% endblock %}

{% block body %}
{% set totalReplies = 0 %}
{% for entry in posts %}
  {% set totalReplies = totalReplies + entry.children_count %}
{% endfor %}
<div>
  {# ==================== HERO ==================== #}
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-24 w-[28rem] h-[28rem] rounded-full bg-accent/20 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-16 w-[20rem] h-[20rem] rounded-full bg-primary/20 blur-3xl"></div>
    </div>
    <div class="relative max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-24 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8 space-y-5">
        <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-accent">
          <span class="w-8 h-0.5 bg-accent"></span> Forum du club
        </p>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-[0.95] tracking-tight">
          Échangez avec<br>
          <span class="text-accent">la communauté.</span>
        </h1>
        <p class="text-base sm:text-lg text-neutral-content/75 max-w-xl leading-relaxed">
          Préparez les déplacements, organisez le covoiturage, partagez vos souvenirs ou posez vos questions.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          {% if is_granted('ROLE_USER') %}
            <button
              class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-xl hover:scale-105 transition min-h-[52px]"
              onclick="document.getElementById('post-modal').showModal()"
              type="button"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
              Nouvelle publication
            </button>
          {% else %}
            <a href="{{ path('app_login') }}" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-xl hover:scale-105 transition min-h-[52px]">
              Se connecter pour publier
            </a>
          {% endif %}
        </div>
      </div>
      <div class="lg:col-span-4 grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">Sujets</dt>
          <dd class="text-4xl lg:text-5xl font-black mt-2 tabular-nums text-accent">{{ totalPosts|default(posts|length) }}</dd>
        </div>
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">Réponses</dt>
          <dd class="text-4xl lg:text-5xl font-black mt-2 tabular-nums">{{ totalReplies }}</dd>
        </div>
      </div>
    </div>
  </section>

  {# ==================== POSTS LIST ==================== #}
  <section class="py-14 lg:py-24 bg-base-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-2">
          <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
            <span class="w-8 h-0.5 bg-primary"></span> Discussions
          </p>
          <h2 class="text-3xl lg:text-4xl font-black tracking-tight">Dernières publications</h2>
          <p class="text-base-content/70">Rejoignez les échanges entre bénévoles, parents et joueurs.</p>
        </div>
        {% if is_granted('ROLE_USER') %}
          <button
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition self-start min-h-[44px]"
            onclick="document.getElementById('post-modal').showModal()"
            type="button"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
            Publier
          </button>
        {% endif %}
      </header>

      <ul class="grid gap-4" role="list">
        {% for post in posts %}
          <li>{% include 'components/post.html.twig' with {post: post} %}</li>
        {% else %}
          <li>
            <div class="text-center py-16 px-4 rounded-3xl border-2 border-dashed border-base-300">
              <svg class="w-16 h-16 mx-auto text-base-content/30 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 20l1.05-3.45C3.38 15.36 3 13.74 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <p class="text-base-content/70 font-bold">Aucune publication pour le moment.</p>
              <p class="text-sm text-base-content/50 mt-1">Soyez la première personne à lancer un sujet !</p>
            </div>
          </li>
        {% endfor %}
      </ul>

      {% set currentPage = currentPage|default(1) %}
      {% set totalPages = totalPages|default(1) %}
      {% if totalPages > 1 %}
        <nav class="flex items-center justify-between gap-3 pt-4 border-t border-base-200" aria-label="Pagination">
          {% if currentPage > 1 %}
            <a href="{{ path('app_forum', {page: currentPage - 1}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              <span class="hidden sm:inline">Précédent</span>
            </a>
          {% else %}
            <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm opacity-40 min-h-[44px]" aria-disabled="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              <span class="hidden sm:inline">Précédent</span>
            </span>
          {% endif %}
          <p class="text-sm font-black uppercase tracking-wider">Page <span class="text-primary">{{ currentPage }}</span> / {{ totalPages }}</p>
          {% if currentPage < totalPages %}
            <a href="{{ path('app_forum', {page: currentPage + 1}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">
              <span class="hidden sm:inline">Suivant</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          {% else %}
            <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm opacity-40 min-h-[44px]" aria-disabled="true">
              <span class="hidden sm:inline">Suivant</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          {% endif %}
        </nav>
      {% endif %}

      <aside class="rounded-3xl bg-base-200 p-6 lg:p-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <p class="text-[11px] font-black uppercase tracking-[0.25em] text-primary">Besoin d'aide ?</p>
          <h3 class="text-xl font-black tracking-tight">Parlez directement avec le staff</h3>
          <p class="text-base-content/70 text-sm">Si vous n'obtenez pas de réponse ici, l'équipe vous accompagne par e-mail.</p>
        </div>
        <a href="{{ path('app_contact') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition md:shrink-0 min-h-[44px]">Nous écrire</a>
      </aside>
    </div>
  </section>
</div>

{% if is_granted('ROLE_USER') %}
<dialog id="post-modal" class="modal" aria-label="Nouvelle publication">
  <div class="modal-box max-w-xl rounded-3xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" onclick="document.getElementById('post-modal').close()" type="button" aria-label="Fermer la fenêtre">✕</button>
    </form>
    {% include 'forum/form.html.twig' with {form: form} %}
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
{% endif %}
{% endblock %}
