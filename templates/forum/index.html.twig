{% extends "base.html.twig" %}

{% block title %}Forum{% endblock %}

{% block body %}
{% set totalReplies = 0 %}
{% for entry in posts %}
  {% set totalReplies = totalReplies + entry.children_count %}
{% endfor %}
<main class="bg-base-200 min-h-screen">
  <section class="bg-neutral text-neutral-content">
    <div class="max-w-5xl mx-auto px-4 py-16 grid gap-12 lg:grid-cols-2">
      <div class="space-y-6">
        <p class="text-xs uppercase tracking-[0.5em] text-neutral-content/60">Forum du club</p>
        <h1 class="text-4xl font-extrabold leading-tight">Partagez vos idées et vos questions avec la communauté MJ Vaubécourt</h1>
        <p class="text-neutral-content/80 text-lg">
          Une place pour préparer les déplacements, organiser les covoiturages, partager des souvenirs ou demander des conseils.
          Lancez une nouvelle discussion ou rejoignez celles en cours.
        </p>
        <div class="flex flex-wrap gap-3">
          {% if is_granted('ROLE_USER') %}
            <button
              class="btn btn-primary btn-wide"
              onclick="document.getElementById('post-modal').showModal()"
              type="button"
            >
              Nouvelle publication
            </button>
          {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-wide">
              Connectez-vous pour publier
            </a>
          {% endif %}
          <a href="{{ path('app_contact') }}" class="btn btn-outline btn-primary btn-wide lg:btn-md">Contacter le club</a>
        </div>
        <div class="grid grid-cols-2 gap-4 text-neutral-content/80">
          <div class="rounded-2xl border border-neutral-content/20 p-4">
            <p class="text-xs uppercase tracking-[0.4em]">Sujets actifs</p>
            <p class="text-3xl font-bold">{{ totalPosts|default(posts|length) }}</p>
          </div>
          <div class="rounded-2xl border border-neutral-content/20 p-4">
            <p class="text-xs uppercase tracking-[0.4em]">Réponses</p>
            <p class="text-3xl font-bold">{{ totalReplies }}</p>
          </div>
        </div>
      </div>
      <div>
        <div class="rounded-3xl border border-neutral-content/20 bg-base-100/10 backdrop-blur shadow-2xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1505664194779-8beaceb93744?auto=format&fit=crop&w=900&q=80"
            alt="Supporters MJ Vaubécourt"
            class="w-full h-80 object-cover">
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 space-y-8">
      <div class="flex flex-col gap-2">
        <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Discussions</p>
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <h2 class="text-3xl font-bold text-base-content">Les dernières publications</h2>
          {% if is_granted('ROLE_USER') %}
            <button
              class="btn btn-primary"
              onclick="document.getElementById('post-modal').showModal()"
              type="button"
            >
              Publier un sujet
            </button>
          {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-primary">
              Connexion pour publier
            </a>
          {% endif %}
        </div>
        <p class="text-base-content/70">Rejoignez les échanges entre bénévoles, parents et joueurs et trouvez rapidement des réponses.</p>
      </div>

      <div class="grid gap-6">
        {% for post in posts %}
          {% include 'components/post.html.twig' with {post: post} %}
        {% else %}
          <p class="text-center text-base-content/60 py-12 rounded-3xl border border-dashed border-base-300 bg-base-100">
            Aucune publication pour le moment. Soyez la première personne à lancer un sujet !
          </p>
        {% endfor %}
      </div>

      {% set currentPage = currentPage|default(1) %}
      {% set totalPages = totalPages|default(1) %}
      {% if totalPages > 1 %}
        <div class="flex flex-col gap-4 items-center justify-between sm:flex-row">
          <div>
            {% if currentPage > 1 %}
              <a href="{{ path('app_forum', {page: currentPage - 1}) }}" class="btn btn-outline btn-primary">
                ← Précédent
              </a>
            {% else %}
              <span class="btn btn-outline btn-disabled pointer-events-none opacity-50">← Précédent</span>
            {% endif %}
          </div>
          <p class="text-sm uppercase tracking-[0.3em] text-base-content/60">Page {{ currentPage }} / {{ totalPages }}</p>
          <div>
            {% if currentPage < totalPages %}
              <a href="{{ path('app_forum', {page: currentPage + 1}) }}" class="btn btn-outline btn-primary">
                Suivant →
              </a>
            {% else %}
              <span class="btn btn-outline btn-disabled pointer-events-none opacity-50">Suivant →</span>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="card bg-base-100 rounded-3xl shadow-xl border border-base-300">
        <div class="card-body gap-4 md:flex md:items-center md:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Besoin d'aide ?</p>
            <h3 class="text-2xl font-bold text-base-content">Parlez directement avec le staff</h3>
            <p class="text-base-content/70">Si vous n'obtenez pas de réponse ici, notre équipe vous accompagne par e-mail ou téléphone.</p>
          </div>
          <a href="{{ path('app_contact') }}" class="btn btn-outline btn-primary">Nous écrire</a>
        </div>
      </div>
    </div>
  </section>
</main>

{% if is_granted('ROLE_USER') %}
<dialog id="post-modal" class="modal">
  <div class="modal-box max-w-xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" onclick="document.getElementById('post-modal').close()" type="button">✕</button>
    </form>
    {% include 'forum/form.html.twig' with {form: form} %}
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
{% endif %}
{% endblock %}
