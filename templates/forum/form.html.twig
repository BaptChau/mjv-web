<div class="space-y-5">
  <header class="space-y-1">
    <p class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.25em] text-primary">
      <span class="w-6 h-0.5 bg-primary"></span> {{ title|default('Nouvelle publication') }}
    </p>
    <h2 class="text-2xl font-black tracking-tight">{{ title|default('Lancez la discussion') }}</h2>
    <p class="text-sm text-base-content/60">Partagez votre question, idée ou retour avec la communauté.</p>
  </header>

  {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
    {% if form.title is defined %}
      <div>
        {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'block text-[11px] font-black uppercase tracking-wider text-base-content/70 mb-1.5'}}) }}
        {{ form_widget(form.title, {'attr': {'class': 'input input-bordered w-full rounded-xl font-semibold focus:border-primary focus:ring-2 focus:ring-primary', 'placeholder': 'Un titre clair', 'maxlength': 120}}) }}
        <div class="text-error text-xs mt-1">{{ form_errors(form.title) }}</div>
      </div>
    {% endif %}

    <div>
      {{ form_label(form.body, 'Message', {'label_attr': {'class': 'block text-[11px] font-black uppercase tracking-wider text-base-content/70 mb-1.5'}}) }}
      {{ form_widget(form.body, {'attr': {'class': 'textarea textarea-bordered w-full rounded-xl min-h-[140px] focus:border-primary focus:ring-2 focus:ring-primary', 'placeholder': 'Partagez votre question ou idée…'}}) }}
      <div class="text-error text-xs mt-1">{{ form_errors(form.body) }}</div>
    </div>

    <div>
      {{ form_label(form.author, 'Auteur', {'label_attr': {'class': 'block text-[11px] font-black uppercase tracking-wider text-base-content/70 mb-1.5'}}) }}
      {{ form_widget(form.author, {'attr': {'class': 'input input-bordered w-full rounded-xl font-semibold focus:border-primary focus:ring-2 focus:ring-primary', 'placeholder': 'Votre nom', 'autocomplete': 'name'}}) }}
      <div class="text-error text-xs mt-1">{{ form_errors(form.author) }}</div>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row sm:justify-end gap-2">
      {{ form_widget(form.save, {'label': 'Publier', 'attr': {'class': 'inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition w-full sm:w-auto sm:min-w-[180px] min-h-[48px] border-0'}}) }}
    </div>
  {{ form_end(form) }}
</div>
