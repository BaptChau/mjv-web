{# Bottom padding so content isn't hidden by the fixed mobile bottom-nav #}
<footer class="relative bg-neutral text-neutral-content mt-auto pb-24 lg:pb-0 overflow-hidden" role="contentinfo">
  {# Top accent strip mirroring the navbar #}
  <div class="h-1 w-full flex" aria-hidden="true">
    <span class="w-6 bg-accent"></span>
    <span class="w-12 bg-secondary"></span>
    <span class="flex-1 bg-primary"></span>
  </div>

  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12">

      {# Brand block #}
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <span class="relative inline-flex w-12 h-12 items-center justify-center rounded-xl bg-primary text-primary-content font-black text-base shadow-lg">
            MJV
            <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-secondary border-2 border-neutral"></span>
          </span>
          <div class="leading-none">
            <p class="text-xl font-black uppercase tracking-tight">MJ Vaubécourt</p>
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-neutral-content/60 mt-1">Handball Club · Meuse</p>
          </div>
        </div>
        <p class="text-xs font-black uppercase tracking-[0.2em] text-primary mt-1">« Le handball c'est notre passion magique »</p>
        <p class="text-sm text-neutral-content/75 leading-relaxed max-w-md">
          Esprit collectif, passion du jeu et engagement local : un club familial qui forme, soutient et célèbre toutes ses équipes.
        </p>
        <a href="{{ path('app_contact') }}" class="inline-flex items-center gap-2 mt-2 px-5 py-2.5 rounded-full bg-primary text-primary-content font-bold text-sm shadow-md hover:shadow-lg hover:scale-[1.02] transition">
          Rejoindre le club
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"/></svg>
        </a>
      </div>

      {# Explore #}
      <div class="lg:col-span-3">
        <h2 class="text-[11px] uppercase tracking-[0.25em] font-black text-neutral-content/60 mb-4 flex items-center gap-2">
          <span class="w-4 h-0.5 bg-primary"></span> Explorer
        </h2>
        <ul class="space-y-2.5 text-sm font-semibold">
          <li><a href="{{ path('app_club') }}" class="hover:text-primary inline-flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"><span class="w-0 group-hover:w-3 h-px bg-primary transition-all"></span>Le club</a></li>
          <li><a href="{{ path('app_team_index') }}" class="hover:text-primary inline-flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"><span class="w-0 group-hover:w-3 h-px bg-primary transition-all"></span>Équipes</a></li>
          <li><a href="{{ path('app_calendar') }}" class="hover:text-primary inline-flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"><span class="w-0 group-hover:w-3 h-px bg-primary transition-all"></span>Calendrier</a></li>
          <li><a href="{{ path('app_news') }}" class="hover:text-primary inline-flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"><span class="w-0 group-hover:w-3 h-px bg-primary transition-all"></span>Actualités</a></li>
        </ul>
      </div>

      {# Community #}
      <div class="lg:col-span-2">
        <h2 class="text-[11px] uppercase tracking-[0.25em] font-black text-neutral-content/60 mb-4 flex items-center gap-2">
          <span class="w-4 h-0.5 bg-secondary"></span> Communauté
        </h2>
        <ul class="space-y-2.5 text-sm font-semibold">
          <li><a href="{{ path('app_forum') }}" class="hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">Forum</a></li>
          <li><a href="{{ path('app_contact') }}" class="hover:text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">Contact</a></li>
        </ul>
      </div>

      {# Legal #}
      <div class="lg:col-span-2">
        <h2 class="text-[11px] uppercase tracking-[0.25em] font-black text-neutral-content/60 mb-4 flex items-center gap-2">
          <span class="w-4 h-0.5 bg-accent"></span> Mentions
        </h2>
        <ul class="space-y-2.5 text-sm font-semibold">
          <li><a href="{{ path('app_mentions_legales') }}" class="hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">Mentions légales</a></li>
          <li><a href="{{ path('app_politique_confidentialite') }}" class="hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">Confidentialité</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-neutral-content/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-content/60">
      <span>© {{ "now"|date("Y") }} <span class="font-bold text-neutral-content/90">MJ Vaubécourt</span> — Tous droits réservés.</span>
      <span class="font-semibold uppercase tracking-wider">Propulsé par Symfony</span>
    </div>
  </div>
</footer>
