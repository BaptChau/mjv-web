{% set currentRoute = app.request.attributes.get('_route') %}
{% set teamGroups = teamService.getMenuGroups() %}
<nav class="bg-base-100 border-b border-base-200">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="{{ path('app_main') }}" class="flex items-center space-x-3">
      <span class="self-center text-2xl font-semibold whitespace-nowrap">MJ Vaubécourt</span>
    </a>
    <button id="menu-toggle" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200" aria-controls="navbar-main" aria-expanded="false">
      <span class="sr-only">Open main menu</span>
      <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 17 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
      </svg>
    </button>
    <div class="hidden w-full lg:block lg:w-auto" id="navbar-main">
      <ul class="font-medium flex flex-col p-4 lg:p-0 mt-4 border border-base-200 rounded-lg bg-base-100 lg:flex-row lg:space-x-8 lg:mt-0 lg:border-0 lg:bg-base-100">
        <li>
          <a href="{{ path('app_club') }}"
             class="block py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent
             {% if currentRoute == 'app_club' %}text-primary font-semibold{% endif %}">
            Club
          </a>
        </li>
        <li>
          <a href="{{ path('app_forum') }}"
             class="block py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent
             {% if currentRoute starts with 'app_forum' %}text-primary font-semibold{% endif %}">
            Forum
          </a>
        </li>
        <li>
          <a href="{{ path('app_calendar') }}"
             class="block py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent
             {% if currentRoute starts with 'app_calendar' %}text-primary font-semibold{% endif %}">
            Calendrier
          </a>
        </li>
        <li>
          <a href="{{ path('app_news') }}"
             class="block py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent
             {% if currentRoute starts with 'app_news' %}text-primary font-semibold{% endif %}">
            Actualités
          </a>
        </li>
        <li id="teams-dropdown" class="dropdown dropdown-bottom lg:dropdown-hover">
          <button id="teams-toggle" type="button" tabindex="0" aria-haspopup="true" aria-expanded="false"
             class="flex items-center w-full py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent gap-1
             {% if currentRoute starts with 'app_team' %}text-primary font-semibold{% endif %}">
            Équipes
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id="teams-menu"
               class="dropdown-content z-20 bg-base-100 border border-base-200 rounded-box shadow mt-1 w-56 p-3 space-y-2">
            {% if teamGroups.youth is not empty %}
              <p class="text-xs uppercase font-semibold text-base-content/60">Jeunes</p>
              <ul class="space-y-1">
                {% for entry in teamGroups.youth %}
                  <li>
                    <a href="{{ path('app_team_details', {slug: entry.slug}) }}" class="block px-2 py-1 rounded hover:bg-base-200">
                      {{ entry.label }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if teamGroups.youth is not empty and teamGroups.adult is not empty %}
              <div class="border-t border-base-200 my-1"></div>
            {% endif %}

            {% if teamGroups.adult is not empty %}
              <p class="text-xs uppercase font-semibold text-base-content/60">Adultes</p>
              <ul class="space-y-1">
                {% for entry in teamGroups.adult %}
                  <li>
                    <a href="{{ path('app_team_details', {slug: entry.slug}) }}" class="block px-2 py-1 rounded hover:bg-base-200">
                      {{ entry.label }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            <div class="border-t border-base-200 pt-2">
              <a href="{{ path('app_team_index') }}" class="block text-sm text-primary font-semibold hover:underline">
                Toutes les équipes
              </a>
            </div>
          </div>
        </li>
        <li>
          <a href="{{ path('app_contact') }}"
             class="block py-2 px-3 rounded hover:bg-base-200 lg:hover:bg-transparent
             {% if currentRoute starts with 'app_contact' %}text-primary font-semibold{% endif %}">
            Contact
          </a>
        </li>
        <!-- Theme selector in navbar -->
        <div class="dropdown dropdown-end ml-4">
          <label tabindex="0" class="btn btn-ghost btn-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-13.66l-.71.71M4.05 19.95l-.71.71M21 12h-1M4 12H3m16.95 7.07l-.71-.71M4.05 4.05l-.71-.71"/>
            </svg>
          </label>
          <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-36">
            <li><a onclick="document.documentElement.setAttribute('data-theme', 'light')">Clair</a></li>
            <li><a onclick="document.documentElement.setAttribute('data-theme', 'dark')">Sombre</a></li>
            <li><a onclick="document.documentElement.setAttribute('data-theme', 'halloween')">MJV</a></li>
          </ul>
        </div>
      </ul>
    </div>
  </div>
</nav>
<script>
  document.getElementById('menu-toggle').addEventListener('click', function () {
    document.getElementById('navbar-main').classList.toggle('hidden');
  });

  (function () {
    const dropdown = document.getElementById('teams-dropdown');
    const toggle = document.getElementById('teams-toggle');
    if (!dropdown || !toggle) {
      return;
    }

    toggle.addEventListener('click', function (event) {
      if (window.innerWidth >= 1024) {
        return; // rely on hover on desktop
      }
      event.preventDefault();
      dropdown.classList.toggle('dropdown-open');
      const expanded = dropdown.classList.contains('dropdown-open') ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', expanded);
    });
    document.addEventListener('click', function (event) {
      if (window.innerWidth >= 1024) {
        return;
      }
      if (!dropdown.contains(event.target)) {
        dropdown.classList.remove('dropdown-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
