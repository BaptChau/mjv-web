<li class="py-2" style="margin-left: {{ [level * 18, 72]|min }}px;">
  {% set node = answer.post %}
  <article class="relative rounded-xl bg-base-100 border border-base-300 p-4 sm:p-5 space-y-2 hover:border-secondary/60 transition-colors">
    {% if level > 0 %}
      <span class="absolute -left-3 top-6 w-3 h-px bg-secondary/40" aria-hidden="true"></span>
      <span class="absolute left-0 top-0 bottom-0 w-0.5 bg-secondary/30 rounded-full" aria-hidden="true"></span>
    {% endif %}
    <header class="flex flex-wrap items-center justify-between gap-2">
      <div class="inline-flex items-center gap-2">
        <span class="w-7 h-7 rounded-full bg-secondary text-secondary-content text-[10px] font-black flex items-center justify-center shadow-sm">
          {{ node.author|first|upper }}
        </span>
        <span class="font-bold text-base-content text-sm">{{ node.author }}</span>
        <span class="px-2 py-0.5 rounded-full bg-secondary/15 text-secondary text-[10px] font-black uppercase tracking-wider">Réponse</span>
      </div>
      {% if node.createdAt is defined %}
        <time datetime="{{ node.createdAt|date('c') }}" class="text-xs font-semibold text-base-content/60 tabular-nums">
          {{ node.createdAt|date('d/m/Y · H:i') }}
        </time>
      {% endif %}
    </header>
    <p class="text-sm text-base-content/85 leading-relaxed whitespace-pre-line">{{ node.body }}</p>
  </article>

  {% if answer.children is defined and answer.children|length > 0 %}
    <ul class="mt-2" role="list">
      {% for child in answer.children %}
        {% include 'components/answer.html.twig' with {answer: child, level: level + 1} %}
      {% endfor %}
    </ul>
  {% endif %}
</li>
