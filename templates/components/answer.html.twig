<li class="py-4" style="margin-left: {{ level * 32 }}px;">
  <article class="rounded-2xl border border-base-300 bg-base-100/90 shadow-sm p-4 space-y-2">
    <div class="flex items-center justify-between text-xs uppercase tracking-[0.3em] text-base-content/60">
      <span>{{ answer.author }}</span>
      {% if answer.createdAt is defined %}
        <span>{{ answer.createdAt|date('d/m/Y H:i') }}</span>
      {% endif %}
    </div>
    <p class="text-base-content/80">{{ answer.body }}</p>
  </article>

  {% if answer.children is defined and answer.children|length > 0 %}
    <ul>
      {% for child in answer.children %}
        {% include 'components/answer.html.twig' with {answer: child, level: level + 1} %}
      {% endfor %}
    </ul>
  {% endif %}
</li>
