<li class="py-4" style="margin-left: {{ level * 32 }}px;">
  {% set node = answer.post %}
  <article class="rounded-2xl bg-base-200/80 border border-base-300 shadow-inner p-4 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs uppercase tracking-[0.3em] text-base-content/60">
      <div class="inline-flex items-center gap-2 text-base-content/70">
        <span class="rounded-full bg-base-300 px-3 py-1 text-[0.65rem]">Réponse</span>
        <span class="font-semibold text-base-content">{{ node.author }}</span>
      </div>
      {% if node.createdAt is defined %}
        <span>{{ node.createdAt|date('d/m/Y H:i') }}</span>
      {% endif %}
    </div>
    <p class="text-base-content/80">{{ node.body }}</p>
  </article>

  {% if answer.children is defined and answer.children|length > 0 %}
    <ul>
      {% for child in answer.children %}
        {% include 'components/answer.html.twig' with {answer: child, level: level + 1} %}
      {% endfor %}
    </ul>
  {% endif %}
</li>
