<a href="{{ post.href }}" class="block">
  <div class="flex items-start gap-2.5">
    <div class="flex flex-col w-full max-w-full leading-1.5 p-4 bg-base-100 rounded-e-xl rounded-es-xl">
      <div class="flex items-center space-x-2">
        <span class="text-sm uppercase font-semibold text-base-content"> {{ post.post.title }}</span>
        <span class="text-xs font-semibold opacity-60"> Écrit par {{ post.post.author }}</span>
        <span class="text-xs text-gray-500">{{ post.children_count }} réponse{{ post.children_count <= 1 ? '' : 's' }}</span>
      </div>
      <p class="text-sm font-normal py-2.5 text-base-content">{{ post.post.body }}</p>
    </div>
    <button class="inline-flex self-center items-center p-2 text-sm font-medium text-center text-gray-900 bg-base-100 rounded-lg hover:bg-base-200 focus:ring-4 focus:outline-none focus:ring-base-200" type="button" title="Répondre">
      <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 9l-6 6 6 6M20 4v7a4 4 0 0 1-4 4H5"/>
      </svg>
    </button>
  </div>
</a>