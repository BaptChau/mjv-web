<article class="rounded-3xl border border-base-300 bg-base-100/90 shadow-sm hover:shadow-xl transition hover:border-primary">
  <a href="{{ post.href }}" class="block p-6 space-y-4">
    <div class="flex items-center justify-between text-xs uppercase tracking-[0.3em] text-base-content/60">
      <span>{{ post.post.author }}</span>
      {% if post.post.createdAt is defined %}
        <span>{{ post.post.createdAt|date('d/m/Y H:i') }}</span>
      {% endif %}
    </div>
    <div class="space-y-2">
      <h3 class="text-2xl font-semibold text-base-content">{{ post.post.title }}</h3>
      <p class="text-base-content/70">{{ post.post.body|u.truncate(170, '...') }}</p>
    </div>
    <div class="flex flex-wrap gap-3 items-center text-sm text-base-content/80">
      <span class="rounded-full bg-base-200 px-3 py-1 text-xs uppercase tracking-[0.3em]">{{ post.children_count }} réponse{{ post.children_count <= 1 ? '' : 's' }}</span>
      <span class="inline-flex items-center gap-2 text-primary">
        Lire la discussion
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3" />
        </svg>
      </span>
    </div>
  </a>
</article>
