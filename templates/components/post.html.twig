<article class="group relative rounded-2xl border border-base-300 bg-base-100 hover:border-primary hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 overflow-hidden">
  <span class="absolute left-0 top-0 bottom-0 w-1 bg-primary scale-y-0 group-hover:scale-y-100 origin-top transition-transform duration-300" aria-hidden="true"></span>
  <a href="{{ post.href }}"
     class="block p-5 lg:p-6 space-y-3.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-2xl">
    <div class="flex items-center justify-between gap-3 text-xs">
      <span class="inline-flex items-center gap-2 min-w-0">
        <span class="w-8 h-8 rounded-full bg-primary text-primary-content text-xs font-black flex items-center justify-center shrink-0 shadow-sm">
          {{ post.post.author|first|upper }}
        </span>
        <span class="font-bold text-base-content truncate">{{ post.post.author }}</span>
      </span>
      {% if post.post.createdAt is defined %}
        <time datetime="{{ post.post.createdAt|date('c') }}" class="shrink-0 font-semibold text-base-content/60 tabular-nums">
          {{ post.post.createdAt|date('d/m/Y · H:i') }}
        </time>
      {% endif %}
    </div>
    <div class="space-y-2">
      <h3 class="text-lg lg:text-xl font-black leading-snug text-base-content group-hover:text-primary transition-colors">
        {{ post.post.title }}
      </h3>
      <p class="text-sm text-base-content/70 leading-relaxed line-clamp-2">
        {{ post.post.body|u.truncate(170, '...') }}
      </p>
    </div>
    <div class="flex flex-wrap gap-2 items-center justify-between pt-3 border-t border-base-200">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-base-200 text-xs font-bold">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 20l1.05-3.45C3.38 15.36 3 13.74 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        {{ post.children_count }} réponse{{ post.children_count <= 1 ? '' : 's' }}
      </span>
      <span class="inline-flex items-center gap-1.5 text-sm font-bold text-primary">
        Lire la discussion
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"/>
        </svg>
      </span>
    </div>
  </a>
</article>
