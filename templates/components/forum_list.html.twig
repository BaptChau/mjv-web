<div class="overflow-x-auto">
    <table class="table table-zebra">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Auteur</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for post in posts %}
                <tr>
                    <td><a href="{{ path('forum_show', {'id': post.id}) }}" class="link link-hover">{{ post.title }}</a></td>
                    <td>{{ post.author.username }}</td>
                    <td>{{ post.createdAt|date('d/m/Y') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
