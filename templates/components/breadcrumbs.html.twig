{% set crumbs = breadcrumbs.getBreadcrumbs() %}
{% if crumbs|length > 1 %}
<div class="max-w-2xl mx-auto w-full px-2 py-2">
  <nav class="bg-base-100 py-2 text-sm" aria-label="Breadcrumb">
    <ol class="list-reset flex text-base-content">
      {% for crumb in crumbs %}
        <li>
          {% if crumb.url and not loop.last %}
            <a href="{{ crumb.url }}" class="hover:underline">{{ crumb.label }}</a>
            <span class="mx-2">/</span>
          {% else %}
            <span class="font-semibold">{{ crumb.label }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
</div>
{% endif %}