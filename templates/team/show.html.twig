{% extends 'base.html.twig' %}

{% block title %}{{ team.label }}{% endblock %}

{% block body %}
<main class="bg-base-200">
  <section class="bg-neutral text-neutral-content">
    <div class="max-w-4xl mx-auto px-4 py-12 space-y-2">
      <a href="{{ path('app_team_details', {slug: categorySlug}) }}" class="text-xs uppercase tracking-[0.3em] text-neutral-content/70 inline-flex items-center gap-2">
        ← Retour à {{ categoryLabel }}
      </a>
      <p class="text-xs uppercase tracking-[0.4em] text-neutral-content/60">{{ categoryLabel }}</p>
      <h1 class="text-4xl font-extrabold leading-tight">{{ team.label }}</h1>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4">
      <article class="card bg-base-100 shadow-xl rounded-3xl border border-base-300 overflow-hidden grid md:grid-cols-2">
        <div class="p-8 space-y-4">
          <div class="flex flex-wrap gap-2 text-xs uppercase tracking-[0.3em] text-base-content/60">
            <span class="badge badge-outline">{{ categoryLabel }}</span>
            <span class="badge badge-outline">{{ team.gender is null ? 'Mixte' : (team.gender ? 'Masculin' : 'Féminin') }}</span>
          </div>
          <p class="text-base-content/80">
            Coach : <span class="font-semibold">{{ team.coach }}</span>
            {% if team.secondCoach %} — Adjoint : <span class="font-semibold">{{ team.secondCoach }}</span>{% endif %}
          </p>
          <p class="text-base-content/70 text-sm leading-relaxed">Travail tactique, rigueur défensive et plaisir de jouer ensemble définissent cette équipe.</p>
          <a href="{{ path('app_contact') }}" class="btn btn-primary btn-sm w-fit">Contacter le staff</a>
        </div>
        <div class="bg-neutral">
          {% if team.photoPath %}
            <img src="{{ team.photoPath }}" alt="{{ team.label }}" class="w-full h-full object-cover opacity-85">
          {% else %}
            <div class="h-full min-h-[280px] flex items-center justify-center text-neutral-content/60 text-sm px-6 text-center">Photo à venir</div>
          {% endif %}
        </div>
      </article>
    </div>
  </section>
</main>
{% endblock %}
