{% extends 'base.html.twig' %}

{% set team_image = team.photoPath ? (team.photoPath starts with 'http' ? team.photoPath : site_url ~ team.photoPath) : default_image %}

{% block title %}{{ team.label }} — Équipe {{ categoryLabel }} MJ Vaubécourt{% endblock %}
{% block meta_description %}Fiche de l'équipe {{ team.label }} ({{ categoryLabel }}) du MJ Vaubécourt : coach principal {{ team.coach }}{% if team.secondCoach %}, adjoint {{ team.secondCoach }}{% endif %}. Découvrez ce collectif de handball.{% endblock %}
{% block og_image %}{{ team_image }}{% endblock %}
{% block og_image_alt %}{{ team.label }} — MJ Vaubécourt{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  "name": {{ team.label|json_encode|raw }},
  "sport": "Handball",
  "url": "{{ site_url }}{{ app.request.pathInfo }}",
  "image": "{{ team_image }}",
  "memberOf": { "@type": "SportsClub", "name": "MJ Vaubécourt", "url": "{{ site_url }}" },
  "coach": [
    { "@type": "Person", "name": {{ team.coach|json_encode|raw }} }{% if team.secondCoach %},
    { "@type": "Person", "name": {{ team.secondCoach|json_encode|raw }} }{% endif %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ site_url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Équipes", "item": "{{ site_url }}{{ path('app_team_index') }}" },
    { "@type": "ListItem", "position": 3, "name": {{ categoryLabel|json_encode|raw }}, "item": "{{ site_url }}{{ path('app_team_details', {slug: categorySlug}) }}" },
    { "@type": "ListItem", "position": 4, "name": {{ team.label|json_encode|raw }}, "item": "{{ site_url }}{{ app.request.pathInfo }}" }
  ]
}
</script>
{% endblock %}

{% block body %}
<div>
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-24 w-[24rem] h-[24rem] rounded-full bg-primary/20 blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-4">
      <nav aria-label="Fil d'Ariane" class="text-xs">
        <ol class="flex items-center gap-2 text-neutral-content/70 font-semibold flex-wrap">
          <li><a href="{{ path('app_team_index') }}" class="hover:text-neutral-content hover:underline">Équipes</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="{{ path('app_team_details', {slug: categorySlug}) }}" class="hover:text-neutral-content hover:underline">{{ categoryLabel }}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-neutral-content" aria-current="page">{{ team.label }}</li>
        </ol>
      </nav>
      <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
        <span class="w-8 h-0.5 bg-primary"></span> {{ categoryLabel }}
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">{{ team.label }}</h1>
    </div>
  </section>

  <section class="py-12 lg:py-20 bg-base-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="rounded-3xl border border-base-300 bg-base-100 overflow-hidden shadow-xl grid md:grid-cols-2">
        <div class="bg-neutral relative min-h-[280px] md:min-h-0">
          {% if team.photoPath %}
            <img src="{{ team.photoPath }}" alt="{{ team.label }}" class="absolute inset-0 w-full h-full object-cover">
          {% else %}
            <div class="absolute inset-0 flex items-center justify-center text-neutral-content/40 text-sm font-semibold px-6 text-center">Photo à venir</div>
          {% endif %}
        </div>
        <div class="p-6 lg:p-10 space-y-5">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-base-200 text-[10px] font-black uppercase tracking-wider">{{ categoryLabel }}</span>
            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider
              {% if team.gender is null %}bg-accent/15 text-accent{% elseif team.gender %}bg-primary/15 text-primary{% else %}bg-secondary/15 text-secondary{% endif %}">
              {% if team.gender is null %}Mixte{% else %}{{ team.gender ? 'Masculin' : 'Féminin' }}{% endif %}
            </span>
          </div>
          <div class="rounded-2xl bg-base-200/60 border border-base-300 p-5 space-y-3">
            <div>
              <p class="text-[11px] font-black uppercase tracking-wider text-base-content/60">Coach principal</p>
              <p class="text-xl font-black mt-0.5">{{ team.coach }}</p>
            </div>
            {% if team.secondCoach %}
              <div class="pt-3 border-t border-base-300">
                <p class="text-[11px] font-black uppercase tracking-wider text-base-content/60">Coach adjoint</p>
                <p class="text-xl font-black mt-0.5">{{ team.secondCoach }}</p>
              </div>
            {% endif %}
          </div>
          <p class="text-base-content/70 leading-relaxed">Travail tactique, rigueur défensive et plaisir de jouer ensemble définissent cette équipe.</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="{{ path('app_contact') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition min-h-[44px]">Contacter le staff</a>
            <a href="{{ path('app_team_details', {slug: categorySlug}) }}" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Retour
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
</div>
{% endblock %}
