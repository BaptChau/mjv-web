{% extends 'base.html.twig' %}

{% block title %}Équipes{% endblock %}

{% block body %}
<div class="container mx-auto max-w-3xl py-6">
  <div class="mb-4">
    <h1 class="text-2xl lg:text-3xl font-semibold">Nos équipes</h1>
    <p class="text-sm text-base-content/70 mt-2">Retrouvez les équipes par catégorie.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {% for entry in teams %}
      {% set primaryTeam = entry.teams|first %}
      <a href="{{ path('app_team_details', {'slug': entry.slug}) }}" class="card compact bg-base-100 shadow hover:shadow-md transition">
        <div class="card-body p-3 flex gap-3 items-center">
          {% if primaryTeam is defined and primaryTeam.photoPath %}
            <img src="{{ primaryTeam.photoPath }}" alt="{{ entry.categoryLabel }}" class="w-20 h-16 object-cover rounded"/>
          {% else %}
            <div class="w-20 h-16 bg-base-200 rounded flex items-center justify-center text-sm">No image</div>
          {% endif %}

          <div class="flex-1">
            <h3 class="font-medium">{{ entry.categoryLabel }}</h3>
            {% set summaries = [] %}
            {% for team in entry.teams %}
              {% set label = team.gender is null ? 'Mixte' : (team.gender ? 'Masculin' : 'Féminin') %}
              {% set summaries = summaries|merge([label ~ ' · ' ~ team.label]) %}
            {% endfor %}
            <p class="text-xs text-base-content/60 mb-1">Compositions: {{ summaries|join(', ') }}</p>
            {% if primaryTeam %}
              <p class="text-xs text-base-content/70">Coach principal: {{ primaryTeam.coach }}</p>
            {% endif %}
          </div>
        </div>
      </a>
    {% else %}
      <div class="text-sm text-base-content/70">Aucune équipe pour l'instant.</div>
    {% endfor %}
  </div>
</div>
{% endblock %}
