{% extends 'base.html.twig' %}

{% block title %}Handball {{ categoryLabel }} — Équipes MJ Vaubécourt{% endblock %}
{% block meta_description %}Catégorie {{ categoryLabel }} du MJ Vaubécourt : compositions, staffs techniques, coachs et photos des équipes de handball jeunes ou seniors qui portent les couleurs du club.{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ site_url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Équipes", "item": "{{ site_url }}{{ path('app_team_index') }}" },
    { "@type": "ListItem", "position": 3, "name": {{ categoryLabel|json_encode|raw }}, "item": "{{ site_url }}{{ app.request.pathInfo }}" }
  ]
}
</script>
{% endblock %}

{% block body %}
<div>
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-24 w-[24rem] h-[24rem] rounded-full bg-primary/20 blur-3xl"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 space-y-5">
      <nav aria-label="Fil d'Ariane" class="text-xs">
        <ol class="flex items-center gap-2 text-neutral-content/70 font-semibold">
          <li><a href="{{ path('app_team_index') }}" class="hover:text-neutral-content hover:underline">Équipes</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-neutral-content" aria-current="page">{{ categoryLabel }}</li>
        </ol>
      </nav>
      <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-primary">
        <span class="w-8 h-0.5 bg-primary"></span> Catégorie
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">{{ categoryLabel }}</h1>
      <p class="text-neutral-content/75 max-w-2xl">Découvrez l'ensemble des collectifs {{ categoryLabel }} : compositions, staffs techniques et dynamique de travail.</p>
    </div>
  </section>

  <section class="py-12 lg:py-20 bg-base-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 lg:gap-7">
        {% for team in teams %}
          <article class="group rounded-3xl border border-base-300 bg-base-100 hover:shadow-2xl hover:border-primary/40 transition-all duration-300 overflow-hidden grid md:grid-cols-12">
            <div class="md:col-span-7 lg:col-span-8 p-6 lg:p-10 flex flex-col gap-4 order-2 md:order-1">
              <div class="space-y-2">
                <p class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.25em] text-primary">
                  <span class="w-2 h-2 rounded-sm bg-primary"></span> {{ categoryLabel }}
                </p>
                <h2 class="text-3xl lg:text-4xl font-black tracking-tight">{{ team.label }}</h2>
              </div>
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider
                  {% if team.gender is null %}bg-accent/15 text-accent{% elseif team.gender %}bg-primary/15 text-primary{% else %}bg-secondary/15 text-secondary{% endif %}">
                  {% if team.gender is null %}Mixte{% else %}{{ team.gender ? 'Masculin' : 'Féminin' }}{% endif %}
                </span>
              </div>
              <div class="rounded-2xl bg-base-200/60 border border-base-300 p-4 space-y-1.5">
                <p class="text-sm"><span class="text-[11px] font-black uppercase tracking-wider text-base-content/60">Coach</span><br><span class="font-black">{{ team.coach }}</span></p>
                {% if team.secondCoach %}
                  <p class="text-sm pt-2 border-t border-base-300"><span class="text-[11px] font-black uppercase tracking-wider text-base-content/60">Adjoint</span><br><span class="font-black">{{ team.secondCoach }}</span></p>
                {% endif %}
              </div>
              <p class="text-sm text-base-content/70 leading-relaxed">Des entraînements adaptés rythment la saison pour atteindre les objectifs fixés avec le staff.</p>
              <a href="{{ path('app_team_show', {slug: categorySlug, id: team.id}) }}" class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-primary text-primary-content font-black uppercase tracking-wide text-sm shadow-md hover:scale-105 transition self-start min-h-[44px] mt-1">
                Fiche équipe
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"/></svg>
              </a>
            </div>
            <div class="md:col-span-5 lg:col-span-4 bg-neutral relative min-h-[220px] md:min-h-0 order-1 md:order-2 overflow-hidden">
              {% if team.photoPath %}
                <img src="{{ team.photoPath }}" alt="{{ team.label }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
              {% else %}
                <div class="absolute inset-0 flex items-center justify-center text-neutral-content/40 text-sm font-semibold px-6 text-center">Photo à venir</div>
              {% endif %}
            </div>
          </article>
        {% else %}
          <p class="text-base-content/60 text-center py-16 px-4 rounded-3xl border-2 border-dashed border-base-300">Aucune équipe n'est enregistrée pour cette catégorie.</p>
        {% endfor %}
      </div>
    </div>
  </section>
</div>
{% endblock %}
