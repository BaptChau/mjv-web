{% extends 'base.html.twig' %}

{% block title %}{{ categoryLabel }}{% endblock %}

{% block body %}
<div class="container mx-auto max-w-3xl py-6">
  <a href="{{ path('app_team_index') }}" class="link link-primary text-sm mb-4 inline-block">← Retour aux équipes</a>

  <div class="mb-6">
    <h1 class="text-3xl font-semibold">{{ categoryLabel }}</h1>
    <p class="text-base-content/70 text-sm">Découvrez les équipes masculines et féminines associées à cette catégorie.</p>
  </div>

  <div class="grid grid-cols-1 gap-6">
    {% for team in teams %}
      <a href="{{ path('app_team_show', {slug: categorySlug, id: team.id}) }}" class="card lg:card-side bg-base-100 shadow transition hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary">
        {% if team.photoPath %}
          <figure class="w-full lg:w-1/3"><img src="{{ team.photoPath }}" alt="{{ team.label }}" class="object-cover w-full h-48 lg:h-full"/></figure>
        {% endif %}

        <div class="card-body">
          <h2 class="card-title">{{ team.label }}</h2>

          <div class="flex flex-wrap gap-2 items-center">
            <span class="badge badge-outline">Catégorie: {{ categoryLabel }}</span>

            {% if team.gender is null %}
              <span class="badge badge-info">Mixte</span>
            {% else %}
              <span class="badge badge-success">{{ team.gender ? 'Masculin' : 'Féminin' }}</span>
            {% endif %}
          </div>

          <p class="text-sm text-base-content/70 mt-3">Coach: <strong>{{ team.coach }}</strong>
            {% if team.secondCoach %} — Adjoint: <strong>{{ team.secondCoach }}</strong>{% endif %}
          </p>

          {% if team.description is defined and team.description %}
            <div class="mt-4 prose text-sm">{{ team.description|raw }}</div>
          {% endif %}
        </div>
      </a>
    {% else %}
      <p class="text-base-content/70">Aucune équipe n'est enregistrée pour cette catégorie.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
