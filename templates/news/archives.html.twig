{% extends "base.html.twig" %}

{% block title %}Archives — Actualités MJ Vaubécourt{% endblock %}

{% block body %}
<div>
  <section class="relative bg-neutral text-neutral-content overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-24 -right-24 w-[24rem] h-[24rem] rounded-full bg-secondary/20 blur-3xl"></div>
    </div>
    <div class="relative max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8 space-y-4">
        <nav aria-label="Fil d'Ariane" class="text-xs">
          <ol class="flex items-center gap-2 text-neutral-content/70 font-semibold">
            <li><a href="{{ path('app_news') }}" class="hover:text-neutral-content hover:underline">Actualités</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-neutral-content" aria-current="page">Archives</li>
          </ol>
        </nav>
        <p class="inline-flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.3em] text-secondary">
          <span class="w-8 h-0.5 bg-secondary"></span> Archives
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">Toutes les actualités du club</h1>
        <p class="text-neutral-content/70 max-w-xl">Retrouvez l'ensemble des articles publiés par le MJ Vaubécourt.</p>
      </div>
      <div class="lg:col-span-4 grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">Articles</dt>
          <dd class="text-4xl font-black mt-2 tabular-nums text-secondary">{{ total|default(newsList|length) }}</dd>
        </div>
        <div class="rounded-2xl border border-neutral-content/15 bg-neutral-content/5 backdrop-blur p-5">
          <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-neutral-content/60">Page</dt>
          <dd class="text-4xl font-black mt-2 tabular-nums">{{ page }}</dd>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 lg:py-20 bg-base-100">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl lg:text-3xl font-black tracking-tight">Toutes les publications</h2>
        <form method="get" class="flex items-center gap-2">
          <label for="perPage" class="text-xs font-black uppercase tracking-wider text-base-content/60">Afficher</label>
          <select name="perPage" id="perPage"
            class="select select-bordered select-sm rounded-full font-bold focus:border-primary"
            onchange="this.form.submit()">
            <option value="5" {{ perPage == 5 ? 'selected' : '' }}>5 / page</option>
            <option value="10" {{ perPage == 10 ? 'selected' : '' }}>10 / page</option>
            <option value="20" {{ perPage == 20 ? 'selected' : '' }}>20 / page</option>
          </select>
          <input type="hidden" name="page" value="1" />
        </form>
      </div>

      <ul class="grid gap-5 lg:gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {% for news in newsList %}
          <li>{% include 'components/news/news.html.twig' with {news: news} %}</li>
        {% else %}
          <li class="sm:col-span-2 lg:col-span-3 text-center py-16 px-4 rounded-3xl border-2 border-dashed border-base-300">
            <p class="text-base-content/60 font-semibold">Aucune actualité pour le moment.</p>
          </li>
        {% endfor %}
      </ul>

      {% if maxPage > 1 %}
        <nav aria-label="Pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-base-200">
          {% if page > 1 %}
            <a href="?page={{ page - 1 }}&perPage={{ perPage }}" class="inline-flex items-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Précédent
            </a>
          {% else %}
            <span class="inline-flex items-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm opacity-40 min-h-[44px]" aria-disabled="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Précédent
            </span>
          {% endif %}
          <p class="text-sm font-black uppercase tracking-wider">Page <span class="text-primary">{{ page }}</span> / {{ maxPage }}</p>
          {% if page < maxPage %}
            <a href="?page={{ page + 1 }}&perPage={{ perPage }}" class="inline-flex items-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm hover:border-primary hover:text-primary transition min-h-[44px]">
              Suivant
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          {% else %}
            <span class="inline-flex items-center gap-2 px-5 py-3 rounded-full border-2 border-base-300 font-black uppercase tracking-wide text-sm opacity-40 min-h-[44px]" aria-disabled="true">
              Suivant
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          {% endif %}
        </nav>
      {% endif %}

      <div class="flex justify-center pt-4">
        <a href="{{ path('app_news') }}" class="inline-flex items-center gap-2 text-sm font-black text-primary hover:underline">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Retour aux actualités
        </a>
      </div>
    </div>
  </section>
</div>
{% endblock %}
