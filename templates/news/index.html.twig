{% extends "base.html.twig" %}

{% block title %}Actualités{% endblock %}

{% block body %}
<main class="bg-base-200 min-h-screen">
  <section class="bg-neutral text-neutral-content">
    <div class="max-w-5xl mx-auto px-4 py-8 lg:py-16 grid gap-6 lg:gap-12 lg:grid-cols-2">
      <div class="space-y-4 lg:space-y-6">
        <p class="text-xs uppercase tracking-[0.5em] text-neutral-content/70">Actualités du club</p>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">Toute la vie du MJ Vaubécourt, semaine après semaine</h1>
        <p class="text-neutral-content/80 text-lg">
          Résumés de match, portraits, événements et vie du club : retrouvez chaque moment fort.
        </p>
        <div class="grid grid-cols-2 gap-4 text-neutral-content/80">
          <div class="rounded-2xl border border-neutral-content/20 p-4">
            <p class="text-xs uppercase tracking-[0.4em]">Articles</p>
            <p class="text-3xl font-bold">{{ total|default(0) }}</p>
          </div>
          <div class="rounded-2xl border border-neutral-content/20 p-4">
            <p class="text-xs uppercase tracking-[0.4em]">Dernières actus</p>
            <p class="text-3xl font-bold">{{ lastNews|length }}</p>
          </div>
        </div>
      </div>
      <div class="hidden lg:block">
        <div class="rounded-3xl border border-neutral-content/20 bg-base-100/10 backdrop-blur shadow-2xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1521412644187-c49fa049e84d?auto=format&fit=crop&w=900&q=80"
            alt="Actualités MJ Vaubécourt"
            class="w-full h-80 object-cover">
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 space-y-8">
      <div class="flex flex-col gap-2">
        <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">À la une</p>
        <h2 class="text-2xl lg:text-3xl font-bold text-base-content">Dernières actualités</h2>
        <p class="text-base-content/70">Les moments clés du club mis en avant.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {% for news in lastNews %}
          {% include 'components/news/news.html.twig' with {news: news} %}
        {% else %}
          <p class="text-center text-base-content/60 py-12 rounded-3xl border border-dashed border-base-300 bg-base-100">
            Aucune actualité récente.
          </p>
        {% endfor %}
      </div>

      <div class="flex justify-center">
        <a href="{{ path('app_news_archives') }}" class="btn btn-outline btn-primary">Voir toutes les archives</a>
      </div>
    </div>
  </section>

  <section class="pb-8 lg:pb-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="card bg-base-100 rounded-3xl shadow-xl border border-base-300">
        <div class="card-body gap-4 md:flex md:items-center md:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.4em] text-base-content/60">Rester informé</p>
            <h3 class="text-2xl font-bold text-base-content">Recevez les prochaines actus du club.</h3>
            <p class="text-base-content/70">Inscrivez-vous auprès du club pour être averti des nouveaux articles.</p>
          </div>
          <a href="{{ path('app_contact') }}" class="btn btn-outline btn-primary">Nous contacter</a>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
