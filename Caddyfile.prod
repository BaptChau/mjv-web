mj-vaubecourt.fr {
    root * /srv/public

    # Serve static files directly
    file_server

    # PHP requests via FastCGI to php-fpm
    # root for php_fastcgi must match the path inside the PHP-FPM container
    php_fastcgi app:9000 {
        root /app/public
    }

    # Compression
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Cache static assets
    @static path /build/* /favicon.ico /robots.txt
    header @static Cache-Control "public, max-age=31536000, immutable"
}

mon-depute.eu, www.mon-depute.eu {
    # SPA Vue + proxy /api vers Flask : tout est gere par le nginx du projet
    # mon-depute, joignable via le reseau Docker partage "web-proxy".
    reverse_proxy mon-depute-web:80

    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
